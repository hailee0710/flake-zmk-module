#include "split_inputs.dtsi"
#include "anywhy_flake.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,display = &oled;
        zmk,physical-layout = &anywhy_flake_layout;
    };

    mock_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /* Sensitivity scaler — adjusts trackpoint cursor speed.
     * Takes two cells: <multiplier divider>.
     *   <2 1> = 2x speed, <1 2> = half speed
     */
    zip_xy_scaler: zip_xy_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
    };

    /* Scroll converter — converts XY movement to scroll wheel.
     * X becomes horizontal scroll, Y becomes vertical scroll.
     */
    zip_xy_to_scroll: zip_xy_to_scroll {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map = <INPUT_REL_X INPUT_REL_HWHEEL>, <INPUT_REL_Y INPUT_REL_WHEEL>;
    };
};

&anywhy_flake_layout {
    kscan = <&mock_kscan>;
};

&trackpoint_listener {
    status = "okay";
    /* 2x sensitivity scaling. Tune <multiplier divider> to adjust speed. */
    input-processors = <&zip_xy_scaler 2 1>;

    /* Layer 2 (scroll): reduced sensitivity + XY-to-scroll conversion.
     * Active when middle-click combo is held. */
    scroll {
        layers = <2>;
        input-processors = <&zip_xy_scaler 1 4>, <&zip_xy_to_scroll>;
    };
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};
