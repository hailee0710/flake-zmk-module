#include "anywhy_flake.dtsi"
#include "anywhy_flake_3610.dtsi"

&trackball_split {
  status = "okay";
};

/* enable the listener on central */
&trackball_listener {
  status = "okay";
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zmk,display = &st7789p3;
        zmk,physical-layout = &large_layout;
        zmk,input-device    = &trackball_split;
    };

    mock_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

};

&large_layout {
        kscan = <&mock_kscan>;
};

/* ST7789P3 display on SPI0 — pacman dongle adapter */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 1)>,
                    <NRF_PSEL(SPIM_SCK, 1, 6)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 1)>,
                    <NRF_PSEL(SPIM_SCK, 1, 6)>;
            low-power-enable;
        };
    };
};

&spi0 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    st7789p3: st7789p3@0 {
        compatible = "sitronix,st7789p3";
        reg = <0>;
        spi-max-frequency = <40000000>;
        width = <320>;
        height = <172>;
        madctl = <0x20>;
        colmod = <0x55>;
        x-offset = <0>;
        y-offset = <0>;
        reset-gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
        dc-gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
    };
}; 
