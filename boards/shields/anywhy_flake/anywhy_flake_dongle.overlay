#include "split_inputs.dtsi"
#include "anywhy_flake.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/input_gestures_accel.dtsi>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,display = &oled;
        zmk,physical-layout = &anywhy_flake_layout;
    };

    mock_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /* Sensitivity scaler — adjusts trackpoint cursor speed.
     * Takes two cells: <multiplier divider>.
     *   <2 1> = 2x speed, <1 2> = half speed
     */
    zip_xy_scaler: zip_xy_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
    };

    /* Scroll converter — converts XY movement to scroll wheel.
     * X becomes horizontal scroll, Y becomes vertical scroll.
     */
    zip_xy_to_scroll: zip_xy_to_scroll {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map = <INPUT_REL_X INPUT_REL_HWHEEL>, <INPUT_REL_Y INPUT_REL_WHEEL>;
    };

    /* Axis transform — swaps XY and/or inverts axes.
     * Takes one cell value as bitmask:
     *   1 = XY swap, 2 = X invert, 4 = Y invert
     *   Combine: 7 = all three (1|2|4)
     */
    zip_xy_transform: zip_xy_transform {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <1>;
        type = <INPUT_EV_REL>;
        y-codes = <INPUT_REL_Y>;
        x-codes = <INPUT_REL_X>;
    };
};

/* Pointer acceleration — speed-dependent curve
 * Config visualizer: https://pointing.streamlit.app/
 *   min-factor: 0.8x at slow speeds (800/1000) — precision
 *   max-factor: 2.5x at fast speeds (2500/1000) — speed
 */
&pointer_accel {
    input-type = <INPUT_EV_REL>;
    track-remainders;
    min-factor = <600>;
    max-factor = <2500>;
    speed-threshold = <1200>;
    speed-max = <6000>;
    acceleration-exponent = <2>;
};

&anywhy_flake_layout {
    kscan = <&mock_kscan>;
};

&trackpoint_listener {
    status = "okay";
    /* Accel → XY swap → 1x scaling */
    input-processors = <&pointer_accel>,
                       <&zip_xy_transform 1>,
                       <&zip_xy_scaler 1 1>;

    /* Layer 2 (scroll): Accel → XY swap + Y invert → 1/32 scale → scroll
     * Active when middle-click combo is held. */
    scroll {
        layers = <2>;
        input-processors = <&pointer_accel>,
                           <&zip_xy_transform 5>,
                           <&zip_xy_scaler 1 18>,
                           <&zip_xy_to_scroll>;
    };
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};
