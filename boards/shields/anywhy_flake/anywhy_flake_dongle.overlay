#include "split_inputs.dtsi"
#include "anywhy_flake.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/pointer_accel.dtsi>

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,display = &oled;
        zmk,physical-layout = &anywhy_flake_layout;
    };

    mock_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    /* Sensitivity scaler — adjusts trackpoint cursor speed.
     * Takes two cells: <multiplier divider>.
     *   <2 1> = 2x speed, <1 2> = half speed
     */
    zip_xy_scaler: zip_xy_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
    };

    /* Scroll converter — converts XY movement to scroll wheel.
     * X becomes horizontal scroll, Y becomes vertical scroll.
     */
    zip_xy_to_scroll: zip_xy_to_scroll {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map = <INPUT_REL_X INPUT_REL_HWHEEL>, <INPUT_REL_Y INPUT_REL_WHEEL>;
    };

    /* Axis transform — swaps XY and/or inverts axes.
     * Takes one cell value as bitmask:
     *   1 = XY swap, 2 = X invert, 4 = Y invert
     *   Combine: 7 = all three (1|2|4)
     */
    zip_xy_transform: zip_xy_transform {
        compatible = "zmk,input-processor-transform";
        #input-processor-cells = <1>;
        type = <INPUT_EV_REL>;
        y-codes = <INPUT_REL_Y>;
        x-codes = <INPUT_REL_X>;
    };
};

/* ── Pointer acceleration (cursor) — sigmoid S-curve ──
 *
 * Shape: flat base at low speed, smooth S-curve ramp, ceiling at high speed.
 *
 * All parameters are in raw-count units (|delta| per sample period)
 * when enable-interval-based-speed is active.
 *
 *   factor
 *   4000 ┤                          .-''''''''''-
 *        ┤                        .'
 *        ┤                      .'
 *        ┤                    .'
 *   300 ┤....................'
 *        └──────┬──────────────────────┬──────→ speed (raw counts)
 *            15                      70
 *
 *   - A raw delta of 1-15 → stays near base factor (0.3x)
 *   - A raw delta of ~42  → halfway through the S (2.15x)
 *   - A raw delta of 70+  → max factor (4.0x)
 */
&pointer_accel {
    input-type = <INPUT_EV_REL>;
    track-remainders;

    curve-type = <1>;                    /* 1 = sigmoid curve */

    /* Legacy polynomial params (unused by sigmoid, kept for reference) */
    min-factor = <100>;
    max-factor = <4000>;
    speed-threshold = <800>;
    speed-max = <6000>;
    acceleration-exponent = <2>;

    /* Sigmoid curve params */
    acceleration-factor-base = <300>;    /* 0.3x at low speed */
    acceleration-factor-max  = <4000>;   /* 4.0x at high speed */
    acceleration-factor-rate = <50>;     /* S-curve steepness */
    acceleration-start-offset = <15>;    /* dead zone (raw counts) */
    max-speed = <70>;                    /* ceiling (raw counts) */

    enable-interval-based-speed;
    input-default-sending-rate = <100>;  /* PS/2 100 Hz */
};

&anywhy_flake_layout {
    kscan = <&mock_kscan>;
};

/* ── Scroll accelerator ──
 * Speed-clamping sigmoid: maps input speed to desired output [1, max_speed],
 * then factor = desired / input. Fast deltas get clamped, not amplified.
 * divisor = 10 further tames the result. curve-type = 2 enables the divisor path. */
pointer_accel_scroll: pointer_accel_scroll {
    compatible = "zmk,input-processor-acceleration";
    status = "okay";
    #input-processor-cells = <0>;
    input-type = <INPUT_EV_REL>;

    curve-type = <2>;                    /* 2 = scroll (speed-clamping sigmoid) */
    acceleration-factor-rate = <30>;
    acceleration-start-offset = <15>;
    max-speed = <70>;
    divisor = <10>;

    enable-interval-based-speed;
    input-default-sending-rate = <100>;
};

&trackpoint_listener {
    status = "okay";
    /* Accel → XY swap → passthrough scaler */
    input-processors = <&pointer_accel>,
                       <&zip_xy_transform 1>,
                       <&zip_xy_scaler 1 1>;

    /* Layer 2 (scroll): Accel → XY swap + Y invert → scroll
     * Active when middle-click combo is held.
     * Dedicated scroll accelerator with divisor = 10. */
    scroll {
        layers = <2>;
        input-processors = <&pointer_accel_scroll>,
                           <&zip_xy_transform 5>,
                           <&zip_xy_to_scroll>;
    };
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};
