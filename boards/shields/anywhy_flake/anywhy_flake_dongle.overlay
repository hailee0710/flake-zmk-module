#include "anywhy_flake.dtsi"
#include "anywhy_flake_3610.dtsi"

&trackball_split {
  status = "okay";
};

/* enable the listener on central */
&trackball_listener {
  status = "okay";
};

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        zephyr,display = &oled;
        zmk,physical-layout = &large_layout;
        zmk,input-device    = &trackball_split;
    };

    mock_kscan: kscan_1 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

};

&large_layout {
        kscan = <&mock_kscan>;
};
